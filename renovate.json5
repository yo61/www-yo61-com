{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // Dependabot keeps npm, the action SHAs and the pre-commit hooks (.github/dependabot.yaml), and
  // supports neither mise.toml nor runner images. Renovate owns the mise.toml tools, and in the
  // workflows the runs-on image and the mise version mise-action installs, never an action SHA.
  // It runs from yo61/infrastructure's workflow, whose cron is the only schedule; do not add a
  // `schedule`.
  extends: ["config:recommended"],
  enabledManagers: ["github-actions", "mise"],

  // Policy shared by every repository Renovate updates; keep the copies alike.
  semanticCommits: "enabled",
  dependencyDashboard: true,
  minimumReleaseAge: "7 days",
  minimumReleaseAgeBehaviour: "timestamp-optional",
  prHourlyLimit: 0,
  prConcurrentLimit: 10,
  osvVulnerabilityAlerts: true,
  vulnerabilityAlerts: {
    semanticCommitType: "fix",
    labels: ["security"],
  },

  packageRules: [
    {
      matchUpdateTypes: ["major"],
      minimumReleaseAge: "14 days",
    },
    {
      // Action SHAs are Dependabot's; Renovate's are runs-on images and, below, jdx/mise.
      matchManagers: ["github-actions"],
      matchDatasources: ["!github-runners"],
      enabled: false,
    },
    {
      // mise-action's `version` input, in every workflow, moves in one PR.
      matchManagers: ["github-actions"],
      matchDepTypes: ["uses-with"],
      matchDepNames: ["jdx/mise"],
      enabled: true,
      groupName: "mise",
    },
    {
      matchFileNames: [".github/workflows/**"],
      semanticCommitScope: "ci",
    },
  ],
}
