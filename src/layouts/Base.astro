---
import "#src/styles/global.css";
import { links, strapline } from "#src/content.ts";

interface Props {
  title: string;
  canonical?: boolean;
}

const { title, canonical = true } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
// The site_token output of yo61/infrastructure's Web Analytics site.
const analyticsBeacon = JSON.stringify({ token: "13e1cc9348ad40f4b7b9e74b9baba39c" });
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={`yo61: ${strapline}`} />
    {canonical && <link rel="canonical" href={canonicalUrl} />}
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={analyticsBeacon}
    ></script>
  </head>
  <body>
    <header class="band">
      <p class="wordmark">yo61</p>
    </header>
    <main class="content">
      <slot />
    </main>
    <footer>
      {links.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </footer>
  </body>
</html>
